# --- Database (Railway Postgres + PostGIS) ---
DATABASE_URL="postgresql://user:password@host:5432/myvboro?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/myvboro?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (magic-link email)
AUTH_RESEND_KEY=""
AUTH_RESEND_FROM="login@myvboro.com"

# --- Map ---
# MapLibre uses Mapbox raster tiles. Get from https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- Storage (Cloudflare R2) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="myvboro-photos"
R2_PUBLIC_URL=""

# --- AI / Embeddings ---
OPENAI_API_KEY=""
