# --- Database (Railway Postgres + PostGIS) ---
# Railway's plain Postgres is unpooled — DATABASE_URL is the direct
# connection. If you later switch to a pooler (PgBouncer / Accelerate /
# Supabase), add `directUrl = env("DIRECT_URL")` back to prisma/schema.prisma
# and set DIRECT_URL to the unpooled URL.
DATABASE_URL="postgresql://user:password@host:5432/myvboro?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (magic-link email)
AUTH_RESEND_KEY=""
AUTH_RESEND_FROM="login@myvboro.com"

# --- Map ---
# No env var needed — tiles come straight from OSM
# (https://{a|b|c}.tile.openstreetmap.org). Fine for dev/MVP, NOT for
# production traffic — swap to a paid raster provider (Stadia, MapTiler,
# etc.) before launch by changing the URL in src/components/OSMMap.tsx.

# --- Storage (Cloudflare R2) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="myvboro-photos"
R2_PUBLIC_URL=""

# --- AI / Embeddings ---
OPENAI_API_KEY=""
