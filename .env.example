# --- Database (Railway Postgres + PostGIS) ---
# Railway's plain Postgres is unpooled. Use the direct URL.
DATABASE_URL="postgresql://user:password@host:5432/myvboro?schema=public"

# --- Session (JWT signing) ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=""
# Used to compute redirect URLs in emails/SMS (no trailing slash)
PUBLIC_APP_URL="http://localhost:3000"

# --- SMS (mock by default) ---
# When SMS_PROVIDER=mock (or empty), OTP is printed to the server log
# instead of being sent. Swap to "twilio" or "aligo" later.
SMS_PROVIDER="mock"

# --- Map ---
# MapLibre uses Mapbox raster tiles. Get from https://account.mapbox.com/
# Empty -> falls back to OSM raster.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- Storage (Cloudflare R2, optional for MVP) ---
# If unset, photo upload endpoint returns a stub URL and skips storage.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="myvboro-photos"
R2_PUBLIC_URL=""

# --- Economy knobs (safe defaults — change in DB later) ---
SIGNUP_POINTS_GRANT="1000"
DAILY_POINTS_GRANT="50"
PLACE_CREATE_COST="100"
